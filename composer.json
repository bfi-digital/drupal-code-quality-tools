{
    "name": "bfi-digital/drupal-code-quality-tools",
    "description": "Install common dev dependencies and handle the scaffolding of required files.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "drupal/coder": "^8.3",
        "mglaman/phpstan-drupal": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "extra": {
        "drupal-scaffold": {
            "file-mapping": {
                "[project-root]/lefthook.yaml": "assets/lefthook.yaml",
                "[project-root]/phpcs.xml": "assets/phpcs.xml",
                "[project-root]/phpstan.neon": "assets/phpstan.neon"
            },
            "gitignore": true
        }
    }
}
